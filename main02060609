class SensorMappingDialog(QDialog):
    def __init__(self, main_window):
        super().__init__(main_window)
        self.main_window = main_window
        self.setWindowTitle("🎛️ 座舱温度传感器快速映射面板")
        self.resize(700, 600)

        self.english_signals = [
            "Temp_DrFaceL", "Temp_DrFaceR", "Temp_PsFaceL", "Temp_PsFaceR", "Temp_RrFaceL", "Temp_RrFaceR",
            "Temp_DrFootL", "Temp_DrFootR", "Temp_PsFootL", "Temp_PsFootR", "Temp_RrFootL1", "Temp_RrFootL2", "Temp_RrFootR1", "Temp_RrFootR2",
            "Temp_MidFaceL1", "Temp_MidFaceL2", "Temp_MidFaceR1", "Temp_MidFaceR2", "Temp_MidFootL1", "Temp_MidFootL2", "Temp_MidFootR1", "Temp_MidFootR2"
        ]
        self.chinese_parts = [
            "主驾左脸", "主驾右脸", "副驾左脸", "副驾右脸", "后排左脸", "后排右脸",
            "主驾左脚", "主驾右脚", "副驾左脚", "副驾右脚", "后排左脚1", "后排左脚2", "后排右脚1", "后排右脚2",
            "中排左脸1", "中排左脸2", "中排右脸1", "中排右脸2", "中排左脚1", "中排左脚2", "中排右脚1", "中排右脚2"
        ]

        self.combos = {}
        self.initUI()

    def initUI(self):
        layout = QVBoxLayout()
        layout.addWidget(QLabel("为左侧固定的传感器信号名，选择对应的中文特征位点：\n(空白项代表不配置该传感器，选定后点击下方覆盖按钮将一键组装至主界面)"))

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        container = QWidget()
        grid = QGridLayout()
        grid.setVerticalSpacing(12)
        grid.setHorizontalSpacing(20)

        for i, eng in enumerate(self.english_signals):
            row = i // 2
            col = (i % 2) * 2

            lbl = QLabel(f"{eng} :")
            lbl.setStyleSheet("font-weight: bold; color: #00796B;")
            grid.addWidget(lbl, row, col)

            cb = QComboBox()
            cb.setEditable(True)
            cb.addItem("")
            cb.addItems(self.chinese_parts)
            if i < len(self.chinese_parts):
                cb.setCurrentText(self.chinese_parts[i])

            self.combos[eng] = cb
            grid.addWidget(cb, row, col + 1)

        container.setLayout(grid)
        scroll.setWidget(container)
        layout.addWidget(scroll)

        btn_apply = QPushButton("🔄 组装映射并覆盖至主界面目标信号列表")
        btn_apply.setStyleSheet("background-color: #00838F; color: white; font-weight: bold; padding: 10px; border-radius: 4px;")
        btn_apply.clicked.connect(self.apply_mappings)
        layout.addWidget(btn_apply)

        self.setLayout(layout)

    def apply_mappings(self):
        new_lines = []
        for eng, cb in self.combos.items():
            chi = cb.currentText().strip()
            if chi:
                new_lines.append(f"{eng} : {chi}")

        if not new_lines:
            self.accept()
            return

        current_text = self.main_window.signal_input.toPlainText()
        lines = current_text.split('\n')

        cleaned_lines = []
        for line in lines:
            if line.strip() == "" or not any(base_part in line for base_part in self.chinese_parts):
                cleaned_lines.append(line)

        new_text_block = "\n".join(new_lines)
        old_text_block = "\n".join(cleaned_lines).strip('\n')

        if old_text_block:
            final_text = new_text_block + "\n\n" + old_text_block
        else:
            final_text = new_text_block

        self.main_window.signal_input.setPlainText(final_text)
        QMessageBox.information(self, "成功", "✅ 选中的传感器映射已成功插入至主界面信号列表的最上方！")
        self.accept()


