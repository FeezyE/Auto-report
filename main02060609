    def open_plot_folder(self):
        path = self.plot_csv_input.text()
        folder = os.path.dirname(path) if path and os.path.exists(os.path.dirname(path)) else os.getcwd()
        if sys.platform == 'win32':
            os.startfile(folder)
        elif sys.platform == 'darwin':
            subprocess.Popen(['open', folder])
        else:
            subprocess.Popen(['xdg-open', folder])

    def view_dbc_signals(self):
        if not self.dbc_files:
            QMessageBox.warning(self, "提示", "请先添加至少一个 DBC！")
            return
        self.log_output_ext.append("正在后台拆解 DBC...")
        QApplication.processEvents()
        signal_info_list = []
        for dbc_path in self.dbc_files:
            dbc_name = os.path.basename(dbc_path)
            temp_db = cantools.database.Database(strict=False)
            try:
                try:
                    with open(dbc_path, 'r', encoding='gbk') as f:
                        temp_db.add_dbc_string(f.read())
                except Exception:
                    with open(dbc_path, 'r', encoding='utf-8', errors='ignore') as f:
                        temp_db.add_dbc_string(f.read())
                for msg in temp_db.messages:
                    for sig in msg.signals:
                        comment = str(sig.comment if sig.comment else "无").replace('\n', ' ')
                        signal_info_list.append(f"{sig.name}  [来源: {dbc_name} | {msg.name}]  --- 注释: {comment}")
            except Exception:
                continue
        signal_info_list = sorted(list(set(signal_info_list)))
        temp_txt_path = os.path.join(os.getcwd(), "DBC_所有可用信号清单.txt")
        with open(temp_txt_path, 'w', encoding='utf-8') as f:
            f.write("\n".join(signal_info_list))
        if sys.platform == 'win32':
            os.startfile(temp_txt_path)
        elif sys.platform == 'darwin':
            subprocess.Popen(['open', temp_txt_path])
        else:
            subprocess.Popen(['xdg-open', temp_txt_path])

