class WindCalibrationDialog(QDialog):
    def __init__(self, parent=None, settings=None):
        super().__init__(parent)
        self.setWindowTitle("🌀 空调前鼓风机档位 -> 实际风速 PCHIP 标定")
        self.settings = settings
        self.inputs = {}
        self.initUI()

    def initUI(self):
        layout = QVBoxLayout()
        layout.addWidget(QLabel("请输入小风挡 10 到 70 对应的实际风速 (m/s)：\n(0挡程序默认对应 0 m/s，计算时将通过 PCHIP 模型进行区间平滑拟合)"))

        grid = QGridLayout()
        default_vals = [1.5, 2.5, 3.5, 4.5, 5.5, 6.5, 7.5]

        for i, level in enumerate(range(10, 80, 10)):
            grid.addWidget(QLabel(f"挡位 {level} :"), i, 0)
            line_edit = QLineEdit()
            saved_val = self.settings.value(f"wind_speed_{level}", default_vals[i], type=float)
            line_edit.setText(str(saved_val))
            self.inputs[level] = line_edit
            grid.addWidget(line_edit, i, 1)
            grid.addWidget(QLabel("m/s"), i, 2)

        layout.addLayout(grid)

        btn_save = QPushButton("💾 保存并应用")
        btn_save.setStyleSheet("background-color: #4CAF50; color: white; font-weight: bold; padding: 6px;")
        btn_save.clicked.connect(self.save_and_close)
        layout.addWidget(btn_save)
        self.setLayout(layout)

    def save_and_close(self):
        for level, line_edit in self.inputs.items():
            try:
                val = float(line_edit.text())
                self.settings.setValue(f"wind_speed_{level}", val)
            except ValueError:
                QMessageBox.warning(self, "错误", f"挡位 {level} 的输入不合法，请填入纯数字！")
                return

        QMessageBox.information(self, "成功", "标定保存成功！提取 CSV 时将生成独立的【实际风速】列。")
        self.accept()


