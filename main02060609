# 舒适性二维查表与动态计算引擎
# ==========================================
def calculate_comfort_limits(df, season, target_score, set_col='主驾设定温度',
                             steady_start_idx=None, steady_end_idx=None, log_callback=None):
    """
    让前端画图查表的靶线逻辑，完全复用底层 comfort_report_calc.py 的稳态判定思路。
    """
    if not HAS_TABLES:
        return df, "❌ 找不到或无法导入【查表参数.py】，退回 20/30℃ 上下限模式。"

    if '车外温度' not in df.columns or set_col not in df.columns:
        return df, f"⚠️ 未提取到 [车外温度] 或 [{set_col}]，退回静态模式。"

    last_amb = df['车外温度'].iloc[-1]
    is_winter = last_amb <= 15

    if is_winter:
        control_columns = [c for c in ['主驾左脚', '主驾右脚'] if c in df.columns]
    else:
        control_columns = [c for c in ['主驾左脸', '主驾右脸'] if c in df.columns]

    steady_df = df

    if steady_start_idx is not None:
        start_idx = max(0, int(steady_start_idx))
        end_idx = min(len(df), int(steady_end_idx)) if steady_end_idx is not None else len(df)
        if start_idx < end_idx:
            steady_df = df.iloc[start_idx:end_idx]
            if log_callback:
                log_callback(f"    📏 绘图靶线计算: 应用手动稳态区间 (行 {start_idx + 1} ~ {end_idx})")
    else:
        if control_columns:
            control_series = df[control_columns].mean(axis=1)
            rolling_max = control_series.rolling(window=60, min_periods=60).max()
            rolling_min = control_series.rolling(window=60, min_periods=60).min()
            fluctuation = rolling_max - rolling_min
            steady_points = fluctuation[fluctuation < 0.2]

            max_time_limit = df.index[0] + pd.Timedelta(minutes=30)

            if not steady_points.empty and steady_points.index[0] <= max_time_limit:
                steady_start_time = steady_points.index[0]
                steady_df = df.loc[steady_start_time:]
            elif df.index[-1] > max_time_limit:
                steady_df = df.loc[max_time_limit:]
            else:
                steady_df = df.iloc[-60:] if len(df) > 60 else df

            if log_callback:
                if not steady_points.empty:
                    log_callback(f"    📏 绘图靶线计算: 自动稳态起点 = {steady_points.index[0]}")
                else:
                    log_callback("    📏 绘图靶线计算: 未找到连续60秒<0.2波动区间，按30min兜底或末端数据处理。")

    amb_raw = steady_df['车外温度'].mean()
    set_raw = steady_df[set_col].mean()

    mean_amb = int(round(amb_raw)) if not pd.isna(amb_raw) else 20
    mean_set = int(round(set_raw)) if not pd.isna(set_raw) else 22

    if log_callback:
        log_callback(f"    🎯 图表渲染锁定基准: 外温={mean_amb}℃, 设定={mean_set}℃, 分线={target_score}")

    amb_idx = max(-30, min(44, mean_amb))
    st_idx_center = max(17, min(35, mean_set))
    list_idx = st_idx_center - 17

    try:
        center_face_temp = df_target_temp.loc[amb_idx, st_idx_center]
        center_foot_temp = df_target_temp_F.loc[amb_idx, st_idx_center]
    except KeyError:
        center_face_temp, center_foot_temp = 25.0, 28.0

    def safe_val(arr, idx):
        return arr[min(idx, len(arr) - 1)]

    try:
        face_upper_6 = tables[season]['upper'].get(6, tables[season]['upper'].get('6'))
        face_upper_7 = tables[season]['upper'].get(7, tables[season]['upper'].get('7'))
        face_lower_6 = tables[season]['lower'].get(6, tables[season]['lower'].get('6'))
        face_lower_7 = tables[season]['lower'].get(7, tables[season]['lower'].get('7'))

        foot_upper_6 = tables_foot[season]['upper'].get(6, tables_foot[season]['upper'].get('6'))
        foot_upper_7 = tables_foot[season]['upper'].get(7, tables_foot[season]['upper'].get('7'))
        foot_lower_6 = tables_foot[season]['lower'].get(6, tables_foot[season]['lower'].get('6'))
        foot_lower_7 = tables_foot[season]['lower'].get(7, tables_foot[season]['lower'].get('7'))

        if target_score == 6.0:
            face_up_val = center_face_temp + abs(safe_val(face_upper_6, list_idx))
            face_dn_val = center_face_temp - abs(safe_val(face_lower_6, list_idx))
            foot_up_val = center_foot_temp + abs(safe_val(foot_upper_6, list_idx))
            foot_dn_val = center_foot_temp - abs(safe_val(foot_lower_6, list_idx))
        elif target_score == 7.0:
            face_up_val = center_face_temp + abs(safe_val(face_upper_7, list_idx))
            face_dn_val = center_face_temp - abs(safe_val(face_lower_7, list_idx))
            foot_up_val = center_foot_temp + abs(safe_val(foot_upper_7, list_idx))
            foot_dn_val = center_foot_temp - abs(safe_val(foot_lower_7, list_idx))
        else:
            face_up_val = center_face_temp + (abs(safe_val(face_upper_6, list_idx)) + abs(safe_val(face_upper_7, list_idx))) / 2.0
            face_dn_val = center_face_temp - (abs(safe_val(face_lower_6, list_idx)) + abs(safe_val(face_lower_7, list_idx))) / 2.0
            foot_up_val = center_foot_temp + (abs(safe_val(foot_upper_6, list_idx)) + abs(safe_val(foot_upper_7, list_idx))) / 2.0
            foot_dn_val = center_foot_temp - (abs(safe_val(foot_lower_6, list_idx)) + abs(safe_val(foot_lower_7, list_idx))) / 2.0
    except Exception as e:
        if log_callback:
            log_callback(f"⚠️ 查表异常，已切换为默认上下限模式。原因: {str(e)}")
        face_up_val, face_dn_val, foot_up_val, foot_dn_val = 30.0, 20.0, 30.0, 20.0

    score_str = str(target_score)
    df[f'{score_str}分面部上限'] = face_up_val
    df[f'{score_str}分面部下限'] = face_dn_val
    df[f'{score_str}分脚部上限'] = foot_up_val
    df[f'{score_str}分脚部下限'] = foot_dn_val

    return df, "成功同步并生成对应靶线！"


# ==========================================
# 线程 1：数据提取转换线程
# ==========================================
class ConversionThread(QThread):
    update_log_signal = pyqtSignal(str)
    finished_signal = pyqtSignal(bool, str)

    def __init__(self, blf_path, dbc_paths, signal_map, csv_path, output_mode,
                 eval_mode, season, region_mode, wind_speeds, target_score,
                 steady_start_idx, steady_end_idx):
        super().__init__()
        self.blf_path = blf_path
        self.dbc_paths = dbc_paths
        self.signal_map = signal_map
        self.target_signals = list(signal_map.keys())
        self.csv_path = csv_path
        self.output_mode = output_mode
        self.eval_mode = eval_mode
        self.season = season
        self.region_mode = region_mode
        self.wind_speeds = wind_speeds
        self.target_score = target_score
        self.steady_start_idx = steady_start_idx
        self.steady_end_idx = steady_end_idx

    def run(self):
        try:
            databases = []
            for dbc in self.dbc_paths:
                db_temp = cantools.database.Database(strict=False)
                try:
                    with open(dbc, 'r', encoding='gbk') as f:
                        db_temp.add_dbc_string(f.read())
                except UnicodeDecodeError:
                    with open(dbc, 'r', encoding='utf-8', errors='ignore') as f:
                        db_temp.add_dbc_string(f.read())
                databases.append(db_temp)

            id_to_db_map = {}
            for db in databases:
                for msg in db.messages:
                    found_signals = [s.name for s in msg.signals if s.name in self.target_signals]
                    if found_signals:
                        if msg.frame_id not in id_to_db_map:
                            id_to_db_map[msg.frame_id] = []
                        id_to_db_map[msg.frame_id].append((db, found_signals))

            self.update_log_signal.emit(f"开始解析 BLF... 共监控 {len(id_to_db_map)} 个独立报文 ID")

            log_reader = can.BLFReader(self.blf_path)
            parsed_data = []
            count = 0

            for msg in log_reader:
                count += 1
                if count % 100000 == 0:
                    self.update_log_signal.emit(f"已读取 {count} 帧原始报文...")

                masked_id = msg.arbitration_id & 0x1FFFFFFF
                target_id = None

                if msg.arbitration_id in id_to_db_map:
                    target_id = msg.arbitration_id
                elif masked_id in id_to_db_map:
                    target_id = masked_id

                if target_id is not None:
                    row = {'Timestamp': msg.timestamp}
                    has_target = False

                    for db_parser, target_sigs in id_to_db_map[target_id]:
                        try:
                            decoded = db_parser.decode_message(msg.arbitration_id, msg.data, allow_truncated=True)
                            for sig_name in target_sigs:
                                if sig_name in decoded:
                                    row[sig_name] = decoded[sig_name]
                                    has_target = True
                        except Exception:
                            continue

                    if has_target:
                        parsed_data.append(row)

            if not parsed_data:
                self.finished_signal.emit(False, "未找到目标信号！请核对信号名称。")
                return

            self.update_log_signal.emit("解析完成，正在转换时间戳...")
            df = pd.DataFrame(parsed_data)
            df['Timestamp'] = pd.to_datetime(df['Timestamp'], unit='s')
            df.set_index('Timestamp', inplace=True)
            df.sort_index(inplace=True)
            df = df.ffill()

            existing_signals = [s for s in self.target_signals if s in df.columns]
            df = df[existing_signals]
            # 支持多别名（值现在是列表）
            rename_map = {}
            extra_copies = []
            for eng, aliases in self.signal_map.items():
                if eng not in df.columns:
                    continue
                if aliases:
                    rename_map[eng] = aliases[0]
                    for alias in aliases[1:]:
                        extra_copies.append((aliases[0], alias))
            
            df.rename(columns=rename_map, inplace=True)
            
            for src_name, new_name in extra_copies:
                if src_name in df.columns:
                    df[new_name] = df[src_name]

            before_rows = len(df)
            complete_rows = df.dropna(how='any')

            if complete_rows.empty:
                self.finished_signal.emit(False, "所有行都存在缺失值，无法生成有效CSV。请检查BLF起始报文或信号选择。")
                return

            first_valid_idx = complete_rows.index.min()
            df = df.loc[first_valid_idx:]

            after_rows = len(df)
            removed_rows = before_rows - after_rows
            if removed_rows > 0:
                self.update_log_signal.emit(f"已删除开头缺失的 {removed_rows} 行，CSV将从第一条完整数据开始。")

            if self.output_mode == 'sec':
                self.update_log_signal.emit("执行【按秒降频】压缩数据...")
                df = df.resample('1s').last().ffill()
            else:
                self.update_log_signal.emit("保留微秒级高频帧...")

            df.rename(columns=self.signal_map, inplace=True)

            set_col_for_calc = '主驾设定温度'
            if self.region_mode == 'europe' and '主驾设定温度' in df.columns:
                self.update_log_signal.emit("🌍 检测为【欧洲车型】，已生成 [+2℃补偿列] 代入计算。")
                df['对应亚洲设定温度'] = (df['主驾设定温度'] + 2.0).clip(upper=35.0)
                set_col_for_calc = '对应亚洲设定温度'

            if HAS_SCIPY:
                pchip = PchipInterpolator([0, 10, 20, 30, 40, 50, 60, 70], self.wind_speeds)
                if '空调前鼓风机档位' in df.columns:
                    self.update_log_signal.emit("🌀 使用 PCHIP 生成前排独立 [实际风速] 列...")
                    df['实际风速'] = pchip(df['空调前鼓风机档位'].fillna(0).clip(0, 70)).clip(min=0)
                if '空调后鼓风机档位' in df.columns:
                    self.update_log_signal.emit("🌀 使用 PCHIP 生成后排独立 [后排实际风速] 列...")
                    valid_rear = df['空调后鼓风机档位'].replace(255, np.nan)
                    df['后排实际风速'] = pchip(valid_rear.fillna(0).clip(0, 70)).clip(min=0)

            if self.eval_mode == 'comfort':
                self.update_log_signal.emit("🔥 正在探测并计算动态基准线...")
                df, calc_msg = calculate_comfort_limits(
                    df=df,
                    season=self.season,
                    target_score=self.target_score,
                    set_col=set_col_for_calc,
                    steady_start_idx=self.steady_start_idx,
                    steady_end_idx=self.steady_end_idx,
                    log_callback=self.update_log_signal.emit
                )
                self.update_log_signal.emit(f"🌟 {calc_msg}")

            if self.output_mode == 'sec':
                df.index = df.index.strftime('%Y-%m-%d %H:%M:%S')
            else:
                df.index = [s[:-3] for s in df.index.strftime('%Y-%m-%d %H:%M:%S.%f')]

            self.update_log_signal.emit("正在生成 CSV 文件...")
            df.to_csv(self.csv_path, index_label="时间(Timestamp)")
            self.finished_signal.emit(True, f"解析并转换完毕！共生成 {len(df)} 行有效数据。")
        except Exception as e:
            self.finished_signal.emit(False, str(e))


# ==========================================
# 线程 2：曲线绘图线程
# ==========================================
class PlotThread(QThread):
    update_log_signal = pyqtSignal(str)
    finished_signal = pyqtSignal(bool, str, dict)

    def __init__(self, csv_path, template_text, plot_mode, wind_speeds, target_score,
                 season, region, start_idx, end_idx, steady_start_idx, steady_end_idx):
        super().__init__()
        self.csv_path = csv_path
        self.template_text = template_text
        self.plot_mode = plot_mode
        self.wind_speeds = wind_speeds
        self.target_score = target_score
        self.season = season
        self.region = region
        self.start_idx = start_idx
        self.end_idx = end_idx
        self.steady_start_idx = steady_start_idx
        self.steady_end_idx = steady_end_idx

    def run(self):
        img_paths_dict = {}

        try:
            self.update_log_signal.emit(f"正在读取 CSV 源数据: {os.path.basename(self.csv_path)}")
            df = pd.read_csv(self.csv_path, index_col=0, parse_dates=True)

            # ========== 舒适性 / 采暖模式预处理 ==========
            if self.plot_mode == 'comfort':
                self.update_log_signal.emit("🔄 检测到为舒适性报告生成，执行绘图基准线热更新与对齐检查...")
                set_col_for_calc = '主驾设定温度'
                if self.region == 'europe':
                    if '对应亚洲设定温度' not in df.columns and '主驾设定温度' in df.columns:
                        df['对应亚洲设定温度'] = (df['主驾设定温度'] + 2.0).clip(upper=35.0)
                    if '对应亚洲设定温度' in df.columns:
                        set_col_for_calc = '对应亚洲设定温度'

                df, _ = calculate_comfort_limits(
                    df=df,
                    season=self.season,
                    target_score=self.target_score,
                    set_col=set_col_for_calc,
                    steady_start_idx=self.steady_start_idx,
                    steady_end_idx=self.steady_end_idx,
                    log_callback=self.update_log_signal.emit
                )

            # 采暖和普通绘图共用区间裁切
            original_len = len(df)
            start_i = self.start_idx if self.start_idx is not None else 0
            end_i = self.end_idx if self.end_idx is not None else original_len
            start_i = max(0, start_i)
            end_i = min(original_len, end_i)

            if start_i >= end_i:
                self.finished_signal.emit(False, "⚠️ 绘图起始行必须小于结束行！", {})
                return

            if start_i > 0 or end_i < original_len:
                df_plot = df.iloc[start_i:end_i].copy()
                self.update_log_signal.emit(f"✂️ 已将画图数据裁切为：第 {start_i + 1} 行 到 第 {end_i} 行。")
            else:
                df_plot = df.copy()

            x_axis = range(0, len(df_plot))
            save_dir = os.path.dirname(self.csv_path)
            base_name = os.path.splitext(os.path.basename(self.csv_path))[0]

            # ========== 采暖专图生成 ==========
            if self.plot_mode == 'heating':
                self.update_log_signal.emit("🔥 开始生成最大采暖评估图表...")

                # 图1：脚部温度趋势
                plotted_foot = False
                fig_foot, ax_foot = plt.subplots(figsize=(15, 7))
                plt.title("最大采暖评估 - 脚部温度趋势", fontweight='bold')

                if '主驾左脚' in df_plot.columns and '主驾右脚' in df_plot.columns:
                    ax_foot.plot(x_axis, (df_plot['主驾左脚'] + df_plot['主驾右脚']) / 2,
                                 label='主驾脚部均值', linewidth=2)
                    plotted_foot = True
                if '副驾左脚' in df_plot.columns and '副驾右脚' in df_plot.columns:
                    ax_foot.plot(x_axis, (df_plot['副驾左脚'] + df_plot['副驾右脚']) / 2,
                                 label='副驾脚部均值', linewidth=2)
                if '主驾设定温度' in df_plot.columns:
                    ax_foot.plot(x_axis, df_plot['主驾设定温度'], '--', label='设定温度', alpha=0.7)
                if '车外温度' in df_plot.columns:
                    ax_foot.plot(x_axis, df_plot['车外温度'], ':', label='车外温度', alpha=0.7)

                if plotted_foot:
                    ax_foot.set_xlabel("数据点序号 (N)")
                    ax_foot.set_ylabel("温度 (℃)")
                    ax_foot.grid(True, linestyle='--', alpha=0.7)
                    ax_foot.margins(x=0)
                    plt.subplots_adjust(bottom=0.25)
                    ax_foot.legend(loc='upper center', bbox_to_anchor=(0.5, -0.15),
                                   fancybox=True, shadow=True, ncol=4)
                    foot_path = os.path.join(save_dir, f"{base_name}_[Heating]_脚部温度.png")
                    plt.savefig(foot_path, dpi=120, bbox_inches='tight')
                    img_paths_dict['img_foot'] = foot_path
                    self.update_log_signal.emit("✅ 采暖图1：脚部温度已生成！")
                plt.close(fig_foot)

                # 图2：出风口温度（按信号名中包含 "Vent" 的列绘制）
                plotted_vent = False
                fig_vent, ax_vent = plt.subplots(figsize=(15, 7))
                plt.title("最大采暖 - 出风口温度", fontweight='bold')
                vent_signals = [c for c in df_plot.columns if 'Vent' in c and 'Temp' in c]
                for col in vent_signals:
                    ax_vent.plot(x_axis, df_plot[col], label=col, linewidth=1.5)
                    plotted_vent = True
                if plotted_vent:
                    ax_vent.set_xlabel("数据点序号 (N)")
                    ax_vent.set_ylabel("温度 (℃)")
                    ax_vent.grid(True, linestyle='--', alpha=0.7)
                    ax_vent.margins(x=0)
                    plt.subplots_adjust(bottom=0.25)
                    ax_vent.legend(loc='upper center', bbox_to_anchor=(0.5, -0.15),
                                   fancybox=True, shadow=True, ncol=4)
                    vent_path = os.path.join(save_dir, f"{base_name}_[Heating]_出风口.png")
                    plt.savefig(vent_path, dpi=120, bbox_inches='tight')
                    img_paths_dict['img_vent'] = vent_path
                    self.update_log_signal.emit("✅ 采暖图2：出风口温度已生成！")
                plt.close(fig_vent)

                self.finished_signal.emit(True, "🎉 采暖图表生成完毕！", img_paths_dict)
                return  # 采暖模式到此结束，不再执行常规组图

            # ========== 舒适性专图 ==========
            if self.plot_mode == 'comfort':
                self.update_log_signal.emit("\n🚀 开始生成独立舒适性评估图表...")

                face_up_col = next((c for c in df_plot.columns if '分面部上限' in c), None)
                face_dn_col = next((c for c in df_plot.columns if '分面部下限' in c), None)
                foot_up_col = next((c for c in df_plot.columns if '分脚部上限' in c), None)
                foot_dn_col = next((c for c in df_plot.columns if '分脚部下限' in c), None)

                # --- 舒适图1：面部 ---
                plotted_face = False
                fig_face, ax_face = plt.subplots(figsize=(15, 7))
                plt.title("空调舒适性评估 - 面部温度趋势图", fontweight='bold')

                if '主驾左脸' in df_plot.columns and '主驾右脸' in df_plot.columns:
                    ax_face.plot(x_axis, (df_plot['主驾左脸'] + df_plot['主驾右脸']) / 2, label='主驾面部均值', linewidth=2)
                    plotted_face = True
                if '副驾左脸' in df_plot.columns and '副驾右脸' in df_plot.columns:
                    ax_face.plot(x_axis, (df_plot['副驾左脸'] + df_plot['副驾右脸']) / 2, label='副驾面部均值', linewidth=2)
                    plotted_face = True
                if '中排左脸1' in df_plot.columns and '中排左脸2' in df_plot.columns:
                    ax_face.plot(x_axis, (df_plot['中排左脸1'] + df_plot['中排左脸2']) / 2, label='中排左脸均值', linewidth=1.5)
                    plotted_face = True
                if '中排右脸1' in df_plot.columns and '中排右脸2' in df_plot.columns:
                    ax_face.plot(x_axis, (df_plot['中排右脸1'] + df_plot['中排右脸2']) / 2, label='中排右脸均值', linewidth=1.5)
                    plotted_face = True
                if '后排左脸' in df_plot.columns:
                    ax_face.plot(x_axis, df_plot['后排左脸'], label='后排左脸', linewidth=1.5)
                if '后排右脸' in df_plot.columns:
                    ax_face.plot(x_axis, df_plot['后排右脸'], label='后排右脸', linewidth=1.5)

                if plotted_face:
                    if face_up_col:
                        ax_face.plot(x_axis, df_plot[face_up_col], color='red', linestyle='-.', linewidth=1.5, label=face_up_col)
                    else:
                        ax_face.axhline(y=30, color='red', linestyle='-.', linewidth=1.5, label='上限(默认30℃)')

                    if face_dn_col:
                        ax_face.plot(x_axis, df_plot[face_dn_col], color='blue', linestyle='-.', linewidth=1.5, label=face_dn_col)
                    else:
                        ax_face.axhline(y=20, color='blue', linestyle='-.', linewidth=1.5, label='下限(默认20℃)')

                    ax_face.set_xlabel("数据点序号 (N)")
                    ax_face.set_ylabel("数值 (℃)")
                    ax_face.grid(True, linestyle='--', alpha=0.7)
                    ax_face.margins(x=0)

                    plt.subplots_adjust(bottom=0.25)
                    ax_face.legend(loc='upper center', bbox_to_anchor=(0.5, -0.15), fancybox=True, shadow=True, ncol=4)

                    face_path = os.path.join(save_dir, f"{base_name}_[评估]_舒适性01-面部.png")
                    plt.savefig(face_path, dpi=120, bbox_inches='tight')
                    img_paths_dict['img_face'] = face_path
                    self.update_log_signal.emit("✅ 舒适性专图 1：面部评估基准线图已生成！")
                plt.close(fig_face)

                # --- 舒适图2：脚部 ---
                plotted_foot = False
                fig_foot, ax_foot = plt.subplots(figsize=(15, 7))
                plt.title("空调舒适性评估 - 脚部温度趋势图", fontweight='bold')

                if '主驾左脚' in df_plot.columns and '主驾右脚' in df_plot.columns:
                    ax_foot.plot(x_axis, (df_plot['主驾左脚'] + df_plot['主驾右脚']) / 2, label='主驾脚部均值', linewidth=2)
                    plotted_foot = True
                if '副驾左脚' in df_plot.columns and '副驾右脚' in df_plot.columns:
                    ax_foot.plot(x_axis, (df_plot['副驾左脚'] + df_plot['副驾右脚']) / 2, label='副驾脚部均值', linewidth=2)
                    plotted_foot = True
                if '中排左脚1' in df_plot.columns and '中排左脚2' in df_plot.columns:
                    ax_foot.plot(x_axis, (df_plot['中排左脚1'] + df_plot['中排左脚2']) / 2, label='中排左脚均值', linewidth=1.5)
                    plotted_foot = True
                if '中排右脚1' in df_plot.columns and '中排右脚2' in df_plot.columns:
                    ax_foot.plot(x_axis, (df_plot['中排右脚1'] + df_plot['中排右脚2']) / 2, label='中排右脚均值', linewidth=1.5)
                    plotted_foot = True
                if '后排左脚1' in df_plot.columns and '后排左脚2' in df_plot.columns:
                    ax_foot.plot(x_axis, (df_plot['后排左脚1'] + df_plot['后排左脚2']) / 2, label='后排左脚均值', linewidth=1.5)
                    plotted_foot = True
                if '后排右脚1' in df_plot.columns and '后排右脚2' in df_plot.columns:
                    ax_foot.plot(x_axis, (df_plot['后排右脚1'] + df_plot['后排右脚2']) / 2, label='后排右脚均值', linewidth=1.5)
                    plotted_foot = True

                if plotted_foot:
                    if foot_up_col:
                        ax_foot.plot(x_axis, df_plot[foot_up_col], color='red', linestyle='-.', linewidth=1.5, label=foot_up_col)
                    else:
                        ax_foot.axhline(y=30, color='red', linestyle='-.', linewidth=1.5, label='上限(默认30℃)')

                    if foot_dn_col:
                        ax_foot.plot(x_axis, df_plot[foot_dn_col], color='blue', linestyle='-.', linewidth=1.5, label=foot_dn_col)
                    else:
                        ax_foot.axhline(y=20, color='blue', linestyle='-.', linewidth=1.5, label='下限(默认20℃)')

                    ax_foot.set_xlabel("数据点序号 (N)")
                    ax_foot.set_ylabel("数值 (℃)")
                    ax_foot.grid(True, linestyle='--', alpha=0.7)
                    ax_foot.margins(x=0)

                    plt.subplots_adjust(bottom=0.25)
                    ax_foot.legend(loc='upper center', bbox_to_anchor=(0.5, -0.15), fancybox=True, shadow=True, ncol=4)

                    foot_path = os.path.join(save_dir, f"{base_name}_[评估]_舒适性02-脚部.png")
                    plt.savefig(foot_path, dpi=120, bbox_inches='tight')
                    img_paths_dict['img_foot'] = foot_path
                    self.update_log_signal.emit("✅ 舒适性专图 2：脚部评估基准线图已生成！")
                plt.close(fig_foot)

                self.finished_signal.emit(True, "\n🎉 恭喜，所有舒适性图式生成完毕！", img_paths_dict)
                return

            # ========== 常规组图 ==========
            groups = []
            current_group = []
            for line in self.template_text.split('\n'):
                line = line.strip()
                if not line:
                    if current_group:
                        groups.append(current_group)
                        current_group = []
                else:
                    if ':' in line:
                        col_name = line.split(':', 1)[1].strip()
                    elif '：' in line:
                        col_name = line.split('：', 1)[1].strip()
                    else:
                        col_name = line.strip()
                    current_group.append(col_name)
            if current_group:
                groups.append(current_group)

            if not groups:
                self.finished_signal.emit(False, "绘图组拆解为空，请检查绘图模板格式", {})
                return

            self.update_log_signal.emit(f"\n📏 开始处理 {len(groups)} 个常规图块...")

            for i, group in enumerate(groups):
                valid_cols = [col for col in group if col in df_plot.columns]
                if not valid_cols:
                    self.update_log_signal.emit(f"⚠️ 警告：模板第 {i + 1} 块信号未找到，已跳过。")
                    continue

                if '空调前鼓风机档位' in valid_cols and '空调后鼓风机档位' in valid_cols:
                    if (df_plot['空调后鼓风机档位'] == 255).any():
                        valid_cols.remove('空调后鼓风机档位')
                        self.update_log_signal.emit("   -> 侦测到后风机存在 255 无效值，已从当前图中剔除后风机。")

                fig, ax = plt.subplots(figsize=(15, 7))
                plt.title(f"数据走势图 - 组 {i + 1}", fontweight='bold')

                ax_right = None
                ax_wind = None

                for col in valid_cols:
                    if col in ['压缩机出口压力', '左侧阳光', '右侧阳光', '左侧阳光值', '右侧阳光值']:
                        if ax_right is None:
                            ax_right = ax.twinx()
                        ax_right.plot(x_axis, df_plot[col], label=f"{col} (右轴)", linewidth=1.5, linestyle='--')
                    else:
                        ax.plot(x_axis, df_plot[col], label=col, linewidth=1.5)

                ax.set_xlabel("数据点序号 (N)")
                ax.set_ylabel("常规数值")
                ax.grid(True, linestyle='--', alpha=0.7)
                ax.margins(x=0)

                if '空调前鼓风机档位' in valid_cols:
                    ax.set_ylim(-5, 75)
                    ax_wind = ax.twinx()

                    if HAS_SCIPY:
                        pchip = PchipInterpolator([0, 10, 20, 30, 40, 50, 60, 70], self.wind_speeds)
                        max_w = float(pchip(70))
                        ax_wind.set_ylim(-0.2, max_w + 1.5)
                        ax_wind.set_ylabel("实际风速 (m/s)", color="purple", fontweight='bold')
                        ax_wind.axhline(y=4.6, color='red', linestyle=':', linewidth=2, label="最大风速要求 (4.6m/s)")

                        if '实际风速' in df_plot.columns:
                            ax_wind.plot(x_axis, df_plot['实际风速'], color='purple', linestyle='-', linewidth=2.5, alpha=0.8, label='前排实际风速')

                        if '空调后鼓风机档位' in valid_cols and '后排实际风速' in df_plot.columns:
                            ax_wind.plot(x_axis, df_plot['后排实际风速'], color='saddlebrown', linestyle='-.', linewidth=2.5, alpha=0.8, label='后排实际风速')

                    if ax_right is not None:
                        ax_wind.spines['right'].set_position(('outward', 65))

                if ax_right is not None:
                    if '压缩机出口压力' in valid_cols:
                        ax_right.set_ylabel("压力数值", color="green")
                    else:
                        ax_right.set_ylabel("阳光辐射", color="green")

                plt.subplots_adjust(bottom=0.25)
                handles, labels = ax.get_legend_handles_labels()

                if ax_right is not None:
                    h2, l2 = ax_right.get_legend_handles_labels()
                    handles.extend(h2)
                    labels.extend(l2)

                if ax_wind is not None:
                    h3, l3 = ax_wind.get_legend_handles_labels()
                    handles.extend(h3)
                    labels.extend(l3)

                ax.legend(handles, labels, loc='upper center', bbox_to_anchor=(0.5, -0.15),
                          fancybox=True, shadow=True, ncol=4)

                first_sig_name = valid_cols[0].replace('/', '_').replace('\\', '_').replace(':', '_')
                img_name = f"{base_name}_Plot_组{i + 1}_{first_sig_name}.png"
                img_path = os.path.join(save_dir, img_name)

                plt.savefig(img_path, dpi=120, bbox_inches='tight')
                plt.close(fig)

                img_paths_dict[f'img{i + 1}'] = img_path
                self.update_log_signal.emit(f"✅ 常规图 {i + 1} 生成成功！")

            self.finished_signal.emit(True, "\n🎉 恭喜，所有常规图式生成完毕！", img_paths_dict)

        except Exception as e:
            self.finished_signal.emit(False, f"绘图失败: {str(e)}", {})


