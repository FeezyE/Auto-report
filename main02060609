    # 标题栏与拉伸事件（保持不变）
    def _get_resize_region(self, pos):
        x, y = pos.x(), pos.y()
        w, h = self.width(), self.height()
        m = self._margin + 5
        region = ""
        if y < m: region += "top"
        elif y > h - m: region += "bottom"
        if x < m: region += "left"
        elif x > w - m: region += "right"
        return region

    def _title_bar_rect_in_window(self):
        return self.title_bar.geometry().translated(self.bg_widget.pos())

    def _is_over_title_bar_buttons(self, pos):
        child = self.childAt(pos)
        while child is not None:
            if child in (self.btn_min, self.btn_close):
                return True
            child = child.parentWidget()
        return False

    def _is_in_draggable_title_bar(self, pos):
        return self._title_bar_rect_in_window().contains(pos) and not self._is_over_title_bar_buttons(pos)

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            region = self._get_resize_region(event.pos())
            if region:
                self._is_resizing = True
                self._resize_dir = region
                event.accept()
                return
            if self._is_in_draggable_title_bar(event.pos()):
                self._is_moving = True
                self._drag_pos = event.globalPos() - self.frameGeometry().topLeft()
                event.accept()
                return
        super().mousePressEvent(event)

    def mouseMoveEvent(self, event):
        if self._is_resizing:
            global_pos = event.globalPos()
            rect = self.geometry()
            if "left" in self._resize_dir: rect.setLeft(global_pos.x())
            if "right" in self._resize_dir: rect.setRight(global_pos.x())
            if "top" in self._resize_dir: rect.setTop(global_pos.y())
            if "bottom" in self._resize_dir: rect.setBottom(global_pos.y())
            if rect.width() >= self.minimumWidth() and rect.height() >= self.minimumHeight():
                self.setGeometry(rect)
            event.accept()
            return
        if self._is_moving and self._drag_pos is not None:
            self.move(event.globalPos() - self._drag_pos)
            event.accept()
            return
        region = self._get_resize_region(event.pos())
        if region in ["topleft", "bottomright"]: self.setCursor(Qt.SizeFDiagCursor)
        elif region in ["topright", "bottomleft"]: self.setCursor(Qt.SizeBDiagCursor)
        elif region in ["left", "right"]: self.setCursor(Qt.SizeHorCursor)
        elif region in ["top", "bottom"]: self.setCursor(Qt.SizeVerCursor)
        else: self.unsetCursor()
        super().mouseMoveEvent(event)

    def mouseReleaseEvent(self, event):
        self._is_resizing = False
        self._is_moving = False
        self._resize_dir = None
        self._drag_pos = None
        self.unsetCursor()
        super().mouseReleaseEvent(event)

