    def generate_wind_column(self):
        csv_path = self.plot_csv_input.text().strip()
        if not csv_path or not os.path.exists(csv_path):
            QMessageBox.warning(self, "错误", "请先选择有效的 CSV 文件！")
            return
        if not HAS_SCIPY:
            QMessageBox.critical(self, "缺少依赖", "该功能需要 scipy 库，请先安装：pip install scipy")
            return
        try:
            df = pd.read_csv(csv_path)
        except Exception as e:
            QMessageBox.critical(self, "读取失败", f"无法读取 CSV：{str(e)}")
            return
        front_exist = '空调前鼓风机档位' in df.columns
        rear_exist = '空调后鼓风机档位' in df.columns
        if not front_exist and not rear_exist:
            QMessageBox.information(self, "无需操作", "CSV 中未找到相关鼓风机档位列。")
            return
        reply = QMessageBox.question(self, "确认修改",
                                     f"即将在以下文件中添加/覆盖风速列：\n{csv_path}\n\n此操作会直接修改原文件，是否继续？",
                                     QMessageBox.Yes | QMessageBox.No)
        if reply != QMessageBox.Yes:
            return
        wind_speeds = [0.0]
        for lvl in range(10, 80, 10):
            wind_speeds.append(self.settings.value(f"wind_speed_{lvl}", lvl / 10.0, type=float))
        from scipy.interpolate import PchipInterpolator
        pchip = PchipInterpolator([0, 10, 20, 30, 40, 50, 60, 70], wind_speeds)
        if front_exist:
            gear = df['空调前鼓风机档位'].fillna(0).clip(0, 70)
            df['实际风速'] = pchip(gear).clip(min=0)
            self.log_output_plot.append("✅ 已为 CSV 添加【实际风速】列（前排）。")
        if rear_exist:
            rear_gear = df['空调后鼓风机档位'].replace(255, np.nan).fillna(0).clip(0, 70)
            df['后排实际风速'] = pchip(rear_gear).clip(min=0)
            self.log_output_plot.append("✅ 已为 CSV 添加【后排实际风速】列。")
        try:
            df.to_csv(csv_path, index=False)
            self.log_output_plot.append(f"💾 风速列已保存至原文件：{csv_path}")
            QMessageBox.information(self, "完成", "实际风速列已成功添加到 CSV 文件中。")
        except Exception as e:
            QMessageBox.critical(self, "保存失败", f"写入文件出错：{str(e)}")

    # ================= 第1页：提取 =================
    def start_extract(self, mode='none'):
        self.pending_plot_mode = mode
        blf = self.blf_input.text()
        csv = self.csv_input.text()
        sig_text = self.signal_input.toPlainText().strip()
        if not (blf and self.dbc_files and sig_text and csv):
            QMessageBox.warning(self, "提示", "提取核心配置未填妥，请检查必填项目")
            return

        mapping = {}
        for line in sig_text.split('\n'):
            line = line.strip()
            if not line: continue
            if ':' in line: parts = line.split(':', 1)
            elif '：' in line: parts = line.split('：', 1)
            else: parts = [line, line]
            eng = parts[0].strip()
            chi = parts[1].strip()
            if not chi: chi = eng
            if eng not in mapping: mapping[eng] = []
            if chi not in mapping[eng]: mapping[eng].append(chi)

        wind_speeds = [0.0]
        for lvl in range(10, 80, 10):
            wind_speeds.append(self.settings.value(f"wind_speed_{lvl}", lvl / 10.0, type=float))

        self.btn_ext_only.setEnabled(False)
        self.btn_ext_norm.setEnabled(False)
        self.btn_ext_comfort.setEnabled(False)
        self.log_output_ext.clear()

        run_mode = "sec" if self.radio_sec.isChecked() else "all"
        season_mode = "summer" if "夏季" in self.season_combo.currentText() else "winter"
        region_mode = "europe" if "欧洲" in self.region_combo.currentText() else "asia"

        score_txt = self.score_combo.currentText()
        if "6.0" in score_txt: target_score = 6.0
        elif "7.0" in score_txt: target_score = 7.0
        else: target_score = 6.5

        steady_start_idx, steady_end_idx = self.get_user_steady_idx()

        self.ext_thread = ConversionThread(
            blf_path=blf, dbc_paths=self.dbc_files, signal_map=mapping,
            csv_path=csv, output_mode=run_mode, eval_mode=mode,
            season=season_mode, region_mode=region_mode,
            wind_speeds=wind_speeds, target_score=target_score,
            steady_start_idx=steady_start_idx, steady_end_idx=steady_end_idx
        )
        self.ext_thread.update_log_signal.connect(lambda t: self.log_output_ext.append(t))
        self.ext_thread.finished_signal.connect(self.on_ext_finished)
        self.ext_thread.start()

    def on_ext_finished(self, success, msg):
        self.log_output_ext.append(msg)
        self.btn_ext_only.setEnabled(True)
        self.btn_ext_norm.setEnabled(True)
        self.btn_ext_comfort.setEnabled(True)
        if success:
            self.plot_csv_input.setText(self.csv_input.text())
            self.plot_template_input.setPlainText(self.signal_input.toPlainText())
            if self.pending_plot_mode != 'none':
                self.tabs.setCurrentIndex(1)
                self.start_plot(mode=self.pending_plot_mode)

    # ================= 第2页：绘图 =================
    def start_plot(self, mode='normal'):
        csv = self.plot_csv_input.text()
        tpl = self.plot_template_input.toPlainText()
        if not os.path.exists(csv):
            QMessageBox.warning(self, "错误", "CSV 文件不存在，请先选择有效数据源。")
            return
        if mode == 'normal' and not tpl.strip():
            QMessageBox.warning(self, "错误", "绘图模板为空，请先输入或同步模板。")
            return
        start_idx, end_idx = self.get_user_plot_range_idx()
        if self.range_start_input.text().strip() or self.range_end_input.text().strip():
            if start_idx is None and end_idx is None:
                QMessageBox.warning(self, "错误", "绘图行数区间必须输入纯数字！")
                return
        steady_start_idx, steady_end_idx = self.get_user_steady_idx()
        wind_speeds = [0.0]
        for lvl in range(10, 80, 10):
            wind_speeds.append(self.settings.value(f"wind_speed_{lvl}", lvl / 10.0, type=float))
        score_txt = self.score_combo.currentText()
        if "7.0" in score_txt: target_score = 7.0
        elif "6.0" in score_txt: target_score = 6.0
        else: target_score = 6.5
        season_mode = "summer" if "夏季" in self.season_combo.currentText() else "winter"
        region_mode = "europe" if "欧洲" in self.region_combo.currentText() else "asia"

        self.btn_plot_normal.setEnabled(False)
        self.btn_plot_comfort.setEnabled(False)
        self.btn_plot_heating.setEnabled(False)
        self.log_output_plot.clear()

        self.plot_thread = PlotThread(
            csv_path=csv, template_text=tpl, plot_mode=mode,
            wind_speeds=wind_speeds, target_score=target_score,
            season=season_mode, region=region_mode,
            start_idx=start_idx, end_idx=end_idx,
            steady_start_idx=steady_start_idx, steady_end_idx=steady_end_idx
        )
        self.plot_thread.update_log_signal.connect(lambda t: self.log_output_plot.append(t))
        self.plot_thread.finished_signal.connect(self.on_plot_finished)
        self.plot_thread.start()

    def on_plot_finished(self, success, msg, img_paths=None):
        if img_paths is None:
            img_paths = {}
        self.log_output_plot.append(msg)
        self.btn_plot_normal.setEnabled(True)
        self.btn_plot_comfort.setEnabled(True)
        self.btn_plot_heating.setEnabled(True)

        if not success:
            return

        if self.plot_thread.plot_mode == 'comfort':
            if not HAS_DOCX or not HAS_CALC:
                self.log_output_plot.append("❌ 缺少 docxtpl 或 comfort_report_calc 依赖，已跳过 Word 生成。")
                return
            self.log_output_plot.append("\n📝 正在组装舒适性报告文档...")
            QApplication.processEvents()
            try:
                df_calc = pd.read_csv(self.plot_csv_input.text(), index_col=0, parse_dates=True)
                if self.plot_thread.region == 'europe':
                    if '对应亚洲设定温度' not in df_calc.columns and '主驾设定温度' in df_calc.columns:
                        df_calc['对应亚洲设定温度'] = (df_calc['主驾设定温度'] + 2.0).clip(upper=35.0)
                calc_kwargs = {}
                sig = inspect.signature(calculate_comfort_report_data)
                if 'wind_speeds' in sig.parameters:
                    calc_kwargs['wind_speeds'] = self.plot_thread.wind_speeds
                if 'steady_start_idx' in sig.parameters:
                    calc_kwargs['steady_start_idx'] = self.plot_thread.steady_start_idx
                    calc_kwargs['steady_end_idx'] = self.plot_thread.steady_end_idx
                if 'log_callback' in sig.parameters:
                    calc_kwargs['log_callback'] = self.log_output_plot.append
                if 'target_score' in sig.parameters:
                    calc_kwargs['target_score'] = self.plot_thread.target_score
                report_data = calculate_comfort_report_data(df_calc, **calc_kwargs)
                tpl_path = self.word_tpl_input.text()
                out_path = self.word_out_input.text()
                if not os.path.exists(tpl_path):
                    self.log_output_plot.append(f"⚠️ 找不到 Word 模板: {tpl_path}，已中断写入流程。")
                    return
                doc = DocxTemplate(tpl_path)
                for img_key, file_path in img_paths.items():
                    if os.path.exists(file_path):
                        report_data[img_key] = InlineImage(doc, file_path, width=Mm(160))
                doc.render(report_data)
                doc.save(out_path)
                self.log_output_plot.append(f"🎉 舒适性报告生成成功！\n📂 {out_path}")
                reply = QMessageBox.question(self, "完成", "报告已生成，是否立即打开？", QMessageBox.Yes | QMessageBox.No)
                if reply == QMessageBox.Yes:
                    if sys.platform == 'win32': os.startfile(out_path)
                    elif sys.platform == 'darwin': subprocess.Popen(['open', out_path])
                    else: subprocess.Popen(['xdg-open', out_path])
            except Exception:
                err_str = traceback.format_exc()
                self.log_output_plot.append(f"❌ 报告失败：\n{err_str}")

        elif self.plot_thread.plot_mode == 'heating':
            # ---- 调用最大采暖报告生成 ----
            self.on_heating_report(success, msg, img_paths)

    def on_heating_report(self, success, msg, img_paths):
        """最大采暖报告生成入口"""
        if not success:
            return
        if not HAS_DOCX:
            self.log_output_plot.append("❌ 缺少 docxtpl 库，无法生成 Word 报告。")
            return
        if not HAS_HEATING_CALC:
            self.log_output_plot.append("❌ 无法导入 heating_report_calc 模块，请确认 heating_report_calc.py 存在。")
            return

        self.log_output_plot.append("\n📝 正在生成最大采暖报告...")
        QApplication.processEvents()

        try:
            csv_path = self.plot_csv_input.text()
            df = pd.read_csv(csv_path, index_col=0, parse_dates=True)

            # 欧洲车型补偿
            if self.plot_thread.region == 'europe' and '主驾设定温度' in df.columns:
                if '对应亚洲设定温度' not in df.columns:
                    df['对应亚洲设定温度'] = (df['主驾设定温度'] + 2.0).clip(upper=35.0)

            calc_kwargs = {}
            calc_kwargs['steady_start_idx'] = self.plot_thread.steady_start_idx
            calc_kwargs['steady_end_idx'] = self.plot_thread.steady_end_idx

            report_data = calculate_heating_report_data(df, **calc_kwargs)

            tpl_path = self.word_tpl_input.text()   # 可复用舒适性模板路径，也可单独设置
            out_path = self.word_out_input.text()
            if not os.path.exists(tpl_path):
                self.log_output_plot.append(f"⚠️ 找不到模板：{tpl_path}")
                return

            doc = DocxTemplate(tpl_path)
            for img_key, img_file in img_paths.items():
                if os.path.exists(img_file):
                    report_data[img_key] = InlineImage(doc, img_file, width=Mm(160))

            doc.render(report_data)
            doc.save(out_path)
            self.log_output_plot.append(f"🎉 最大采暖报告已生成：\n📂 {out_path}")

            reply = QMessageBox.question(self, "完成", "是否立即打开报告？",
                                         QMessageBox.Yes | QMessageBox.No)
            if reply == QMessageBox.Yes:
                if sys.platform == 'win32':
                    os.startfile(out_path)
                elif sys.platform == 'darwin':
                    subprocess.Popen(['open', out_path])
                else:
                    subprocess.Popen(['xdg-open', out_path])

        except Exception:
            err = traceback.format_exc()
            self.log_output_plot.append(f"❌ 采暖报告生成失败：\n{err}")

    # ================= 设置持久化 =================
    def load_settings(self):
        self.blf_input.setText(self.settings.value("blf_path", ""))
        self.csv_input.setText(self.settings.value("csv_path", ""))
        self.signal_input.setPlainText(self.settings.value("signal_text", ""))
        self.plot_csv_input.setText(self.settings.value("plot_csv", ""))
        self.plot_template_input.setPlainText(self.settings.value("plot_template", ""))
        self.word_tpl_input.setText(self.settings.value("word_tpl_path", "报告模板.docx"))
        self.word_out_input.setText(self.settings.value("word_out_path", "评测报告.docx"))
        self.range_start_input.setText(self.settings.value("range_start", ""))
        self.range_end_input.setText(self.settings.value("range_end", ""))
        self.steady_start_input.setText(self.settings.value("steady_start", ""))
        self.steady_end_input.setText(self.settings.value("steady_end", ""))
        self.season_combo.setCurrentIndex(self.settings.value("season_index", 0, type=int))
        self.score_combo.setCurrentIndex(self.settings.value("score_index", 1, type=int))
        self.region_combo.setCurrentIndex(self.settings.value("region_index", 0, type=int))
        output_mode = self.settings.value("output_mode", "sec")
        if output_mode == "sec": self.radio_sec.setChecked(True)
        else: self.radio_all.setChecked(True)
        dbcs = self.settings.value("dbc_files", [])
        if dbcs:
            if not isinstance(dbcs, list): dbcs = [dbcs]
            for f in dbcs:
                if f and os.path.exists(f) and f not in self.dbc_files:
                    self.dbc_files.append(f)
                    self.dbc_listWidget.addItem(os.path.basename(f))

    def closeEvent(self, event):
        self.settings.setValue("blf_path", self.blf_input.text())
        self.settings.setValue("csv_path", self.csv_input.text())
        self.settings.setValue("signal_text", self.signal_input.toPlainText())
        self.settings.setValue("plot_csv", self.plot_csv_input.text())
        self.settings.setValue("plot_template", self.plot_template_input.toPlainText())
        self.settings.setValue("word_tpl_path", self.word_tpl_input.text())
        self.settings.setValue("word_out_path", self.word_out_input.text())
        self.settings.setValue("range_start", self.range_start_input.text())
        self.settings.setValue("range_end", self.range_end_input.text())
        self.settings.setValue("steady_start", self.steady_start_input.text())
        self.settings.setValue("steady_end", self.steady_end_input.text())
        self.settings.setValue("season_index", self.season_combo.currentIndex())
        self.settings.setValue("score_index", self.score_combo.currentIndex())
        self.settings.setValue("region_index", self.region_combo.currentIndex())
        self.settings.setValue("output_mode", "sec" if self.radio_sec.isChecked() else "all")
        self.settings.setValue("dbc_files", self.dbc_files)
        super().closeEvent(event)


